{
  "name": "2api-plugin-workbuddy",
  "version": "1.2.0",
  "displayName": "本地 WorkBuddy 网关",
  "description": "通过本机 WorkBuddy 兼容接口调用已配置的账号；不直接管理 WorkBuddy 平台账号。",
  "runtime": {
    "language": "typescript",
    "entry": "index.ts",
    "protocol": 2
  },
  "models": [
    {
      "id": "glm-5.2",
      "upstreamId": "cn:glm-5.2"
    },
    {
      "id": "glm-5.3",
      "upstreamId": "cn:glm-5.3"
    },
    {
      "id": "deepseek-v4.1-flash",
      "upstreamId": "cn:deepseek-v4.1-flash"
    }
  ],
  "config": {
    "baseUrl": "http://127.0.0.1:7863",
    "chatPath": "/v1/chat/completions",
    "modelsPath": "/v1/models",
    "timeoutSeconds": 120
  },
  "specVersion": 2,
  "actions": [
    {
      "id": "gateway_accounts",
      "label": "查看原网关账号状态",
      "description": "只读展示原网关的缓存状态；积分可能陈旧或未知，不直接查询上游。",
      "scope": "account",
      "idempotency": "read",
      "timeoutSeconds": 20,
      "required": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "gateway_cache"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "accounts": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "nickname": {
                  "type": "string",
                  "maxLength": 256
                },
                "realm": {
                  "type": "string",
                  "maxLength": 32
                },
                "cachedCredits": {
                  "type": "number",
                  "minimum": 0
                },
                "cachedCreditsTotal": {
                  "type": "number",
                  "minimum": 0
                },
                "disabled": {
                  "type": "boolean"
                },
                "paused": {
                  "type": "boolean"
                },
                "cooling": {
                  "type": "boolean"
                }
              },
              "required": [
                "uid",
                "nickname",
                "realm"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "source",
          "truncated",
          "accounts"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "gateway_account_pause",
      "label": "暂停原网关账号选号",
      "description": "仅操作原 WorkBuddy 网关中指定账号；超时后请先核对原网关状态。",
      "scope": "account",
      "idempotency": "side_effect",
      "concurrencyKey": "gateway-account-state",
      "timeoutSeconds": 20,
      "required": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "uid"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "gateway_account_resume",
      "label": "恢复原网关账号选号",
      "description": "仅操作原 WorkBuddy 网关中指定账号；超时后请先核对原网关状态。",
      "scope": "account",
      "idempotency": "side_effect",
      "concurrencyKey": "gateway-account-state",
      "timeoutSeconds": 20,
      "required": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "uid"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    }
  ]
}
